{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DoubleTake",
          "version": "0.2.0",
          "informationUri": "https://github.com/Aadithya-kl/doubletake",
          "rules": [
            {
              "id": "pdf.white_text",
              "name": "White-on-white text",
              "shortDescription": {
                "text": "Split-view leak: White-on-white text"
              },
              "fullDescription": {
                "text": "Payload drawn in white on a white page."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pdf.tiny_font",
              "name": "Microscopic font",
              "shortDescription": {
                "text": "Split-view leak: Microscopic font"
              },
              "fullDescription": {
                "text": "Payload drawn at 0.5pt."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pdf.render_mode_3",
              "name": "Invisible render mode",
              "shortDescription": {
                "text": "Split-view leak: Invisible render mode"
              },
              "fullDescription": {
                "text": "Text render mode 3 (no fill, no stroke)."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pdf.off_page",
              "name": "Off-page coordinates",
              "shortDescription": {
                "text": "Split-view leak: Off-page coordinates"
              },
              "fullDescription": {
                "text": "Payload placed outside the MediaBox."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pdf.covered",
              "name": "Covered by shape",
              "shortDescription": {
                "text": "Split-view leak: Covered by shape"
              },
              "fullDescription": {
                "text": "Payload drawn, then painted over by an opaque rectangle."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pdf.clipped",
              "name": "Clipped away",
              "shortDescription": {
                "text": "Split-view leak: Clipped away"
              },
              "fullDescription": {
                "text": "Payload drawn inside a 1x1pt clipping path."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pdf.alpha_zero",
              "name": "Zero opacity",
              "shortDescription": {
                "text": "Split-view leak: Zero opacity"
              },
              "fullDescription": {
                "text": "Payload drawn with fill alpha 0."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "pdf.metadata",
              "name": "Document metadata",
              "shortDescription": {
                "text": "Split-view leak: Document metadata"
              },
              "fullDescription": {
                "text": "Payload in Subject/Keywords info fields."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
